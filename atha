#!/bin/bash

# ATHA - Simple Package Manager Wrapper
# github.com/Bangkah/Atha

CMD=$1
if [ $# -gt 0 ]; then
  shift
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LOCAL_BASE="$SCRIPT_DIR/commands"
SYSTEM_BASE="/usr/lib/atha/commands"
BASE="$LOCAL_BASE"

if [ -d "$LOCAL_BASE" ]; then
  BASE="$LOCAL_BASE"
elif [ -d "$SYSTEM_BASE" ]; then
  BASE="$SYSTEM_BASE"
fi

if [ -f "$BASE/lib/colors.sh" ]; then
  source "$BASE/lib/colors.sh"
elif [ -f "$LOCAL_BASE/lib/colors.sh" ]; then
  source "$LOCAL_BASE/lib/colors.sh"
else
  RED=$'\033[1;31m'
  YELLOW=$'\033[1;33m'
  BLUE=$'\033[1;34m'
  RESET=$'\033[0m'
fi

if [ ! -d "$BASE" ] && [ -d "$LOCAL_BASE" ]; then
  BASE="$LOCAL_BASE"
fi

case $CMD in
  install|remove|search|update|list|info|doctor|history)
        bash "$BASE/$CMD.sh" "$@"
        ;;
    --help|-h|"")
        printf "%b" "${BLUE}atha${RESET} - Simple Package Manager Wrapper

${YELLOW}Usage:${RESET}
  atha install <pkg>            Install package
  atha remove <pkg>             Remove package
  atha search <pkg>             Search package
  atha update                   Update system
  atha list [installed|all]     List packages
  atha info <pkg>               Show package info
  atha doctor                   Check dependencies
  atha history [--limit N]      Show operation history
  atha --help                   Show this help

${YELLOW}Options:${RESET}
  --plan                        Decision analysis mode (what and why)
  --dry-run                     Execution simulation mode (what would run)
  --yes                         Skip confirmation prompts when available
  --timeline                    Show history as chronological events
  --summary                     Show history summary by action and status
  --action <name>               Filter history by action (install/remove/update)
  --status <name>               Filter history by status (success/failed/planned/...)

${YELLOW}Examples:${RESET}
  atha install vim
  atha install --dry-run vim neovim
  atha install --plan vim
  atha remove --plan vim
  atha update --plan
  atha history --summary --limit 50
  atha history --action install --status success --timeline
  atha search python
  atha list installed
  atha info bash
  atha doctor
  atha history --timeline
  atha history --limit 30
  atha update

${YELLOW}Repository:${RESET}
  https://github.com/Bangkah/Atha
"
        ;;
    *)
  echo -e "${RED}[atha] ❌ Unknown command: $CMD${RESET}"
  echo -e "${YELLOW}Try 'atha --help' for more information${RESET}"
        exit 1
        ;;
esac
